# ============================================================================
# .env.example - Configuration Template
# ============================================================================
# DO NOT COMMIT .env - Git is configured to ignore it
# Copy this to .env and fill in your actual values
# This file is for local development and testing only

# ============================================================================
# CockroachDB Configuration (REQUIRED)
# ============================================================================
# Get these from your CockroachDB Cloud console:
# 1. Sign up at https://cockroachlabs.cloud (free, no credit card required)
# 2. Create a Serverless (Basic) cluster
# 3. Click "Connect" → "Connection String" → copy the PostgreSQL URL
# 4. Paste it below, replacing the placeholder

COCKROACH_DB_URL=postgresql://crock:TwZ-PWR6hm0upqMvu1gyew@wary-mole-31800.j77.aws-ap-southeast-1.cockroachlabs.cloud:26257/agent_memory?sslmode=verify-full

# Cluster ID from CockroachDB Cloud UI (Settings → Cluster Details)
CLUSTER_ID=248ad6fd-61b5-4a21-b3b8-04d89d9ce240

# ============================================================================
# Agent Memory Configuration
# ============================================================================

# URL to the Agent Memory API (for Lambda sync, optional)
# Leave empty if using only local/MCP setup
AGENT_MEMORY_API_URL=

# Minimum salience threshold (0.0-1.0) for syncing to CockroachDB
# Facts with salience >= this value are promoted to long-term storage
# Set high (0.6+) to keep low-value chatter local only
SYNC_SALIENCE_THRESHOLD=0.6

# ============================================================================
# MemPalace Configuration (Local Memory)
# ============================================================================

# Optional: Override default MemPalace home directory
# Default: ~/.mempalace/agent-memory
# MEMPALACE_HOME=/path/to/your/palace

# ============================================================================
# AWS Configuration (OPTIONAL - only if using S3 for logs/exports)
# ============================================================================
# Not required for core functionality; used only for logging and artifacts

# AWS credentials (use AWS SSO or ~/.aws/credentials for production)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=us-east-1

# S3 bucket for storing logs and memory exports (optional)
# AWS_S3_LOGS_BUCKET=agent-memory-logs-your-username

# ============================================================================
# Additional Configuration
# ============================================================================

# Debug output (set to "cockroach-mcp:*" for MCP server debug logs)
# DEBUG=

